{
  "name": "retake-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --disable-warning=ExperimentalWarning --test src/*.test.mjs",
    "build": "tsc -b && vite build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,mjs}\" index.html vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,mjs}\" index.html vite.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "prettier": "^3.9.9",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
  }
}
